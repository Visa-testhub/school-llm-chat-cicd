[Unit]
Description=Week 5 LLM Chat (Flask + Gunicorn)
After=network.target mysql.service ollama.service
Wants=mysql.service ollama.service

[Service]
User=chatapp
Group=www-data
SupplementaryGroups=chatapp

WorkingDirectory=/opt/chatapp/app
EnvironmentFile=/etc/chatapp/chatapp.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=XDG_RUNTIME_DIR=/run/chatapp

RuntimeDirectory=chatapp
RuntimeDirectoryMode=0750

ExecStart=/opt/chatapp/venv/bin/gunicorn \
    --workers 1 \
    --worker-class gthread \
    --threads 4 \
    --timeout 300 \
    --bind unix:/run/chatapp/gunicorn.sock \
    --umask 0o007 \
    app:app

Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target